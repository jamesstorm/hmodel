#compdef hmodel
# zsh completion for hmodel — switch the Hermes default model/provider safely (#141063)
#
# install: put this file in a directory that is on $fpath, named _hmodel, and make
# sure the directory is added to $fpath BEFORE compinit runs. In ~/.zshrc:
#
#     mkdir -p ~/.local/share/zsh/site-functions
#     cp _hmodel ~/.local/share/zsh/site-functions/
#     # in ~/.zshrc, above the compinit lines:
#     fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
#     autoload -Uz compinit && compinit
#
# do not `source` this file — zsh completion functions are autoloaded by compinit.
# if $ZDOTDIR is set, zsh reads $ZDOTDIR/.zshrc instead of ~/.zshrc (`echo $ZDOTDIR`).

_hmodel() {
  local -a providers models
  local CFG="${HERMES_HOME:-$HOME/.hermes}/config.yaml"

  # the first python3 that can import yaml — vendor venvs included; override with HMODEL_PY
  local PY="" c
  for c in ${HMODEL_PY:-} /usr/bin/python3 /usr/local/bin/python3 ${commands[python3]:-} \
           $HOME/.hermes/*/bin/python3(N) $HOME/.local/share/uv/python/*/bin/python3(N); do
    [[ -n $c && -x $c ]] || continue
    if "$c" -c 'import yaml' 2>/dev/null; then PY="$c"; break; fi
  done
  [[ -n $PY ]] || return 1

  # provider slugs from config
  providers=(${(f)"$("$PY" - "$CFG" <<'PY' 2>/dev/null
import sys, yaml
try:
    d = yaml.safe_load(open(sys.argv[1]))
    for k in (d.get('providers') or {}):
        print(k)
except Exception:
    pass
PY
)"})

  # models for a provider slug: its static models: list if present, else query the endpoint
  _hmodel_models() {
    local slug="$1"
    models=(${(f)"$("$PY" - "$CFG" "$slug" <<'PY' 2>/dev/null
import sys, yaml, json, urllib.request
cfg, slug = sys.argv[1], sys.argv[2]
try:
    d = yaml.safe_load(open(cfg))
    p = (d.get('providers') or {}).get(slug)
    if not p:
        sys.exit()
    ms = p.get('models')
    if isinstance(ms, dict):
        for k in ms: print(k)
        sys.exit()
    if isinstance(ms, list):
        for k in ms: print(k)
        sys.exit()
    base = (p.get('base_url') or '').rstrip('/')
    key = p.get('api_key') or ''
    req = urllib.request.Request(base + '/models', headers={'Authorization': 'Bearer ' + key})
    data = json.load(urllib.request.urlopen(req, timeout=10))
    for x in data.get('data', []):
        print(x['id'])
except Exception:
    pass
PY
)"})
  }

  local -a args
  args=('--listproviders[list configured providers]' \
        '--list[list models for all providers]' \
        '--set[set provider and/or model]' \
        '--no-restart[edit only, do not restart the gateway]')

  if (( CURRENT == 2 )); then
    _describe 'command' args
    return
  fi

  case "${words[2]}" in
    --set)
      if (( CURRENT == 3 )); then
        _describe 'provider' providers
      elif (( CURRENT == 4 )); then
        _hmodel_models "${words[3]}"
        # compadd, not _describe: model IDs contain ':' (qwen3:4b, ...:batch, ...:free)
        # and _describe treats everything after the first colon as a description, so it
        # would insert a truncated model ID
        compadd -a models
      else
        _describe 'option' args
      fi
      ;;
    --list)
      _describe 'provider' providers
      ;;
    *)
      _describe 'option' args
      ;;
  esac
}
